# ========================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ========================================
# Copy this file and rename to .env.prod
# Fill in the values and NEVER commit the actual .env.prod file
# This template can be committed safely as it contains no real secrets

# ===== Spring Boot Profile =====
SPRING_PROFILES_ACTIVE=prod

# ===== Server Configuration =====
SERVER_PORT=8081

# ===== Database Configuration =====
# Replace with your production database connection
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/psg_backend_prod?useSSL=true&serverTimezone=America/Argentina/Buenos_Aires
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# ===== JWT Configuration =====
# CRITICAL: Generate a NEW secret key for production
# Use: openssl rand -base64 64
# The secret MUST be at least 64 characters long
JWT_SECRET=GENERATE_NEW_SECRET_KEY_MINIMUM_64_CHARS_USING_OPENSSL_RAND_BASE64_64
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ===== CORS Configuration =====
# Replace with your production frontend URL(s)
# Multiple origins: https://yourdomain.com,https://www.yourdomain.com
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ===== Optional: SSL Configuration (if handling SSL in Spring Boot) =====
# SSL_KEYSTORE_PASSWORD=your_keystore_password

# ========================================
# GENERATION COMMANDS
# ========================================
# To generate a secure JWT secret:
#
# Linux/Mac:
#   openssl rand -base64 64
#
# Windows PowerShell:
#   $bytes = New-Object Byte[] 64
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
#
# Node.js:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#
# ========================================
# IMPORTANT SECURITY NOTES
# ========================================
# 1. NEVER use the default JWT secret in production
# 2. NEVER commit the actual .env.prod file
# 3. Use different secrets for dev/staging/prod environments
# 4. Rotate JWT secret every 3-6 months
# 5. Store secrets in a secure vault (AWS Secrets Manager, Azure Key Vault, etc.)
# 6. Use strong, unique passwords for database
# 7. Enable SSL/TLS for database connections
# 8. Restrict CORS to only your production frontend domain(s)

