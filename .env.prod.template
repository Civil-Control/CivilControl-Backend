# ========================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ========================================
# 1. Copiar este archivo: cp .env.prod.template .env.prod
# 2. Completar todos los valores
# 3. NUNCA commitear .env.prod (ya está en .gitignore)
# 4. Levantar con: docker compose --env-file .env.prod up -d
# ========================================

# ===== Spring Boot Profile =====
SPRING_PROFILES_ACTIVE=prod

# ===== Server =====
SERVER_PORT=8081

# ===== Base de datos =====
# Usar un usuario y contraseña fuertes — mínimo 20 caracteres aleatorios
DB_USERNAME=appuser
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE_MINIMO_20_CHARS

# ===== JWT =====
# CRÍTICO: generar un secreto nuevo con:
#   Linux/Mac:  openssl rand -base64 64
#   PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Max 256 }))
# El secreto DEBE tener al menos 64 caracteres y ser diferente al de desarrollo
JWT_SECRET=REEMPLAZAR_CON_SECRET_GENERADO_MINIMO_64_CHARS
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ===== CORS =====
# Solo el dominio del frontend de producción
APP_CORS_ALLOWED_ORIGINS=https://tudominio.com

# ===== Resend (Email transaccional) =====
# Obtener en: https://resend.com → API Keys
# El FROM debe ser un dominio verificado en Resend
# Dejar RESEND_API_KEY vacío para usar modo desarrollo (OTP se loguea en consola)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=notificaciones@tudominio.com
RESEND_FROM_NAME=CivilControl

# ===== WhatsApp Cloud API (Meta) =====
# Obtener en: https://developers.facebook.com → Tu App → WhatsApp → Getting Started
# WHATSAPP_PHONE_ID: ID numérico del número en WhatsApp Manager → Phone Numbers
# WHATSAPP_ACCESS_TOKEN: token permanente de un System User (no expira)
# Dejar WHATSAPP_PHONE_ID y WHATSAPP_ACCESS_TOKEN vacíos para modo desarrollo
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
